"com_github_jmhodges_bazel_bugs is a place for reproducing bugs in the Bazel software ecosystem"

module(
    name = "com_github_jmhodges_bazel_bugs",
    version = "1.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_go", version = "0.57.0")
bazel_dep(name = "gazelle", version = "0.45.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_pemistahl_lingua_go")
